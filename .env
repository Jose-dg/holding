# ==================================
# 🗄️  DATABASE CONFIGURATION
# ==================================
DB_HOST=db
DB_PORT=3306
MARIADB_VERSION=10.6
MARIADB_ROOT_PASSWORD=change_me_root_dev
MYSQL_ROOT_PASSWORD=change_me_root_dev
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_MAX_CONNECTIONS=151

# ==================================
# 🔴 REDIS CONFIGURATION
# ==================================
REDIS_VERSION=7-alpine
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379
# Cache redis memory limit (LRU eviction)
REDIS_CACHE_MAXMEMORY=256mb
REDIS_CACHE_EVICTION=allkeys-lru

# ==================================
# 🌐 FRAPPE/ERPNEXT CONFIGURATION
# ==================================
SITE_NAME=erp.local
ADMIN_PASSWORD=admin123
SOCKETIO_PORT=9000
# Comma-separated apps to install
INSTALL_APPS=erpnext,workflows

# ==================================
# 👤 USER CONFIGURATION
# ==================================
# UID/GID for frappe user (match host user for volume permissions)
FRAPPE_USER_UID=1000
FRAPPE_USER_GID=1000

# ==================================
# 🚀 BACKEND CONFIGURATION
# ==================================
BACKEND_PORT=8000

# ==================================
# 🌍 FRONTEND/NGINX CONFIGURATION
# ==================================
FRONTEND_PORT=8081
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# ==================================
# 🏥 HEALTHCHECK CONFIGURATION
# ==================================
HEALTHCHECK_INTERVAL=15s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10

# ==================================
# 🐳 DOCKER IMAGE CONFIGURATION
# ==================================
REGISTRY=ghcr.io/your-org
IMAGE_NAME=erpnext-workflows
IMAGE_TAG=v0.1.0